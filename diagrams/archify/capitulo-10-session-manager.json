  "messages": [
    {
      "id": "state-in",
      "from": "agentloop",
      "to": "sessionmgr",
      "y": 185,
      "label": "createOrUpdateSessionCheckpoint(existingSession, agentState, execution, agentId)",
      "variant": "dashed",
      "note": "agentState ya producido por AgentLoop tras un turno — CH-01, conceptual, este capítulo no cablea esa llamada"
    },
    {
      "id": "persist-call",
      "from": "sessionmgr",
      "to": "storage",
      "y": 215,
      "label": "persistSessionState(...)",
      "variant": "emphasis",
      "note": "¿agentState.sessionId != execution.sessionId? → HarnessError SESSION_ID_MISMATCH (VALIDATION); construye un SessionCheckpoint nuevo embebiendo agentState sin modificarlo; actualiza runIds (agrega agentState.runId si todavía no estaba)"
    },
    {
      "id": "persist-return",
      "from": "storage",
      "to": "sessionmgr",
      "y": 245,
      "label": "OK | falla",
      "variant": "return",
      "note": "falla → HarnessError SESSION_PERSISTENCE_FAILED (PERSISTENCE) + AgentEvent; éxito → continúa"
    },
    {
      "id": "emit-checkpoint",
      "from": "sessionmgr",
      "to": "events",
      "y": 275,
      "label": "EMIT AgentEvent (SESSION_CHECKPOINT_CREATED)",
      "variant": "dashed"
    },
    {
      "id": "reconstruct-call",
      "from": "agentloop",
      "to": "sessionmgr",
      "y": 330,
      "label": "reconstructSessionState(checkpoint, runIds, execution, agentId)",
      "variant": "dashed",
      "note": "¿checkpoint == NULL? → HarnessError CHECKPOINT_REQUIRED_FOR_RECONSTRUCTION (VALIDATION)"
    },
    {
      "id": "read-checkpoint",
      "from": "sessionmgr",
      "to": "storage",
      "y": 360,
      "label": "lee el SessionCheckpoint ya persistido",
      "variant": "default"
    },
    {
      "id": "checkpoint-return",
      "from": "storage",
      "to": "sessionmgr",
      "y": 390,
      "label": "SessionCheckpoint",
      "variant": "return"
    },
    {
      "id": "emit-reconstructed",
      "from": "sessionmgr",
      "to": "events",
      "y": 420,
      "label": "EMIT AgentEvent (SESSION_RECONSTRUCTED)",
      "variant": "dashed"
    },
    {
      "id": "reconstructed-return",
      "from": "sessionmgr",
      "to": "agentloop",
      "y": 450,
      "label": "SessionState (reconstruido — INV-13)",
      "variant": "return",
      "note": "reconstruye un SessionState completo, exclusivamente desde el checkpoint ya persistido"
    }
  ],
