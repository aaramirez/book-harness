  "cards": [
    {
      "title": "Un solo turno gobernado",
      "items": [
        "runGovernedEnterpriseTurn: primera formalización ejecutable de un turno enterprise completo",
        "Construida solo con funciones ya publicadas por CH-00..CH-24, sin modificar ninguna"
      ],
      "dot": "cyan"
