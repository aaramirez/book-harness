  "messages": [
    {
      "id": "admission-eval",
      "from": "trigger",
      "to": "admission",
      "y": 175,
      "label": "evaluateAdmissionForActivationRequest → AdmissionDecision",
      "variant": "emphasis"
    },
    {
      "id": "admission-audit",
      "from": "admission",
      "to": "auditledger",
      "y": 205,
      "label": "recordAuditEntry(execution = NULL) → AuditRecord",
      "variant": "default",
      "note": "sin AgentEvent posible — CH-14 §14; ¿outcome == ADMIT? NO → RETURN NULL (fin de la traza, sin AgentRun)"
    },
    {
      "id": "run-started",
      "from": "auditledger",
      "to": "agentcore",
      "y": 240,
      "label": "ADMIT → activateAgent / beginAgentInitialization → AgentState",
      "variant": "emphasis",
      "note": "EMIT RUN_STARTED → EventBus"
    },
    {
      "id": "assemble-context",
      "from": "agentcore",
      "to": "contextgov",
      "y": 275,
      "label": "assembleContextSnapshot (ContextEngine) → ContextSnapshot",
      "variant": "default",
      "note": "classifyData por ContextBlock (DataGovernanceEngine) → DataGovernanceLabel; EMIT DATA_CLASSIFIED"
    },
    {
      "id": "resolve-skill",
      "from": "contextgov",
      "to": "skillmodel",
      "y": 310,
      "label": "resolveSkillForSituation (SkillLibrary) → SkillDescriptor",
      "variant": "default",
      "note": "EMIT SKILL_RESOLVED; luego invokeModelForTurn (ModelGateway)"
    },
    {
      "id": "waiting-tool",
      "from": "skillmodel",
      "to": "agentloopsession",
      "y": 345,
      "label": "runTurn → WAITING_FOR_TOOL",
      "variant": "default",
      "note": "mismo patrón que CH-12 §11; AgentLoop persiste el AgentState vía SessionManager"
    },
    {
      "id": "resolve-toolcall",
      "from": "agentloopsession",
      "to": "cappolicy",
      "y": 380,
      "label": "resolveModelProposedToolCall (CapabilityRegistry) → ToolCall",
      "variant": "default",
      "note": "evaluatePolicyForToolCall (PolicyEngine) → PolicyDecision(ALLOW)"
    },
    {
      "id": "resolve-credential",
      "from": "cappolicy",
      "to": "guardas",
      "y": 415,
      "label": "ALLOW → resolveCredentialReference (CredentialBroker) → CredentialReference",
      "variant": "emphasis",
      "note": "EMIT CREDENTIAL_RESOLVED; checkIdempotency (IdempotencyGuard) → Optional<IdempotencyRecord>"
    },
    {
      "id": "execute-tool",
      "from": "guardas",
      "to": "toolruntime",
      "y": 450,
      "label": "¿registro COMPLETED existente? NO → executeToolCall → ToolResult",
      "variant": "emphasis"
    },
    {
      "id": "record-idempotent",
      "from": "toolruntime",
      "to": "guardas",
      "y": 485,
      "label": "recordIdempotentExecution (IdempotencyGuard) → IdempotencyRecord(COMPLETED)",
      "variant": "return",
      "note": "EMIT IDEMPOTENT_EXECUTION_RECORDED"
    },
    {
      "id": "audit-real",
      "from": "guardas",
      "to": "auditledger",
      "y": 520,
      "label": "recordAuditEntry(execution real) → AuditRecord",
      "variant": "default",
      "note": "EMIT AUDIT_RECORD_CREATED → EventBus"
    },
    {
      "id": "second-turn",
      "from": "auditledger",
      "to": "agentcore",
      "y": 555,
      "label": "segundo runTurn (ExecutionController)",
      "variant": "default"
    },
    {
      "id": "assemble-context-2",
      "from": "agentcore",
      "to": "contextgov",
      "y": 590,
      "label": "assembleContextSnapshot + classifyData (segundo turno, mismo patrón)",
      "variant": "default"
    },
    {
      "id": "invoke-model-2",
      "from": "contextgov",
      "to": "skillmodel",
      "y": 625,
      "label": "invokeModelForTurn (segundo turno)",
      "variant": "default"
    },
    {
      "id": "run-completed",
      "from": "skillmodel",
      "to": "agentloopsession",
      "y": 660,
      "label": "runTurn → finished = TRUE",
      "variant": "emphasis",
      "note": "AgentLoop persiste AgentState(COMPLETED) vía SessionManager"
    }
