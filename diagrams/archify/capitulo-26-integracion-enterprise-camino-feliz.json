    {
      "title": "Fail-closed y reuso",
      "items": [
        "ADMIT negado → RETURN NULL, sin AgentRun",
        "IdempotencyRecord ya COMPLETED → reusa ToolResult, no re-ejecuta"
      ],
      "dot": "rose"
    },
    {
      "title": "Observabilidad",
      "items": [
        "Cada AgentEvent emitido llega a EventBus (CH-09)",
        "La admisión es la única llamada a AuditLedger sin AgentEvent (CH-14 §14)"
      ],
