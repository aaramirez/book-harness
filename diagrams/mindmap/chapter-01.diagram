  "CONCEPT-component-sovereignty" [label="Component Sovereignty", shape=ellipse, fillcolor="#fff3a3", URL="chapters/CH-00.html#CONCEPT-component-sovereignty", style="filled"];
  "CONCEPT-probabilistic-system" [label="Probabilistic System", shape=ellipse, fillcolor="#fff3a3", URL="chapters/CH-00.html#CONCEPT-probabilistic-system", style="filled"];
  "CH-01" [label="El Agent Loop y el Ciclo de Ejecución Cognitiva", shape=folder, fillcolor="#e2e2e2", URL="chapters/CH-01.html", style="filled,bold", penwidth=3, color="#d62728"];
