  "CONCEPT-agent-run" [label="Agent Run", shape=ellipse, fillcolor="#fff3a3", URL="chapters/CH-01.html#CONCEPT-agent-run", style="filled,bold", penwidth=3, color="#d62728"];
  "CONCEPT-decision-ownership" [label="Decision Ownership", shape=ellipse, fillcolor="#fff3a3", URL="chapters/CH-01.html#CONCEPT-decision-ownership", style="filled,bold", penwidth=3, color="#d62728"];
