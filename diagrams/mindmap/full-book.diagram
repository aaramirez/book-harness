digraph BookMindMap {
  rankdir=LR;
  size="6.5,9"; ratio=compress;
  node [fontname="Helvetica", fontsize=11, style=filled, target="_top"];
  edge [fontname="Helvetica", fontsize=9];
  labelloc="t"; fontsize=14; fontname="Helvetica-Bold"; label="Mapa mental completo del libro";
