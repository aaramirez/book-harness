#!/usr/bin/env node
'use strict';

/**
 * build-pdf — BookIR → dist/book.pdf vía pandoc (Fase 6 del plan, motor decidido en plan §8.2).
 *
 * Lee EXCLUSIVAMENTE dist/book-ir.json — el mismo BookIR que consume build-web — y no mantiene
 * una copia independiente del contenido de los capítulos (BOOK_HARNESS_BUILD_INSTRUCTIONS(1).md
 * §12: "The PDF renderer controls presentation only. It must not maintain an independent copy of
 * chapter content.").
 *
 * pandoc instalado en el entorno es 1.19.2.4 (pre-2.0): usa `--latex-engine`, NO `--pdf-engine`.
 */

const fs = require('fs');
const path = require('path');
const { execFileSync } = require('child_process');
const { renderDiagram } = require('./lib/render-diagram.js');

const ROOT = path.resolve(__dirname, '..');
const IR_PATH = path.join(ROOT, 'dist', 'book-ir.json');
const BUILD_DIR = path.join(ROOT, 'dist', '.build');
const MINDMAP_BUILD_DIR = path.join(BUILD_DIR, 'mindmap');
const MD_PATH = path.join(BUILD_DIR, 'book.md');
const PDF_PATH = path.join(ROOT, 'dist', 'book.pdf');

function today() {
  return new Date().toISOString().slice(0, 10);
}

function flatten(text) {
  return String(text || '').replace(/\s+/g, ' ').trim();
}

/**
 * Página de apertura del capítulo (Ciclo de Dominio Activo, Sección 0 — Preguntas Guía):
 * expectedOutcome + skeleton + guidingQuestions, SIN respuestas (plan §3.4).
 */
function openingBoxMarkdown(rs) {
  const sk = rs.skeleton || {};
  let out = '> **Antes de leer**\n>\n';
  out += `> **Resultado esperado.** ${flatten(rs.expectedOutcome && rs.expectedOutcome.text)}\n>\n`;
  out += '> **Esqueleto de este capítulo.**\n>\n';
  for (const t of sk.sectionTitles || []) out += `> - ${flatten(t)}\n`;
  out += `>\n> Contratos que se van a introducir: ${(sk.contractsToBeIntroduced || []).join(', ') || '(ninguno)'}. `;
  out += `Componentes que se van a introducir: ${(sk.componentsToBeIntroduced || []).join(', ') || '(ninguno)'}.\n>\n`;
  out += '> **Preguntas guía** (respóndelas de memoria en la página de Repaso, sin volver a mirar atrás):\n>\n';
  (rs.guidingQuestions || []).forEach((q, i) => {
    out += `> ${i + 1}. ${flatten(q.text)}\n`;
  });
  return out + '\n';
}

/**
 * Página "Lente de Sistemas" (Sección 20), antes del cierre del capítulo (plan §3.4).
 */
function systemsLensMarkdown(rs) {
  const sl = rs.systemsLens || {};
  let out = '\\newpage\n\n## Lente de Sistemas\n\n';
  out += '_Releyendo la arquitectura de este capítulo con el marco Iceberg / Bucles de retroalimentación / Punto de apalancamiento (Dinámica de Sistemas, Forrester/Meadows)._\n\n';
  out += '### El Iceberg\n\n';
  out += `1. **Hecho visible:** ${flatten(sl.icebergVisibleFact)}\n`;
  out += `2. **Patrones que se repiten:** ${flatten(sl.icebergPatterns)}\n`;
  out += `3. **Estructuras / reglas / incentivos:** ${flatten(sl.icebergStructures)}\n`;
  out += `4. **Modelos mentales:** ${flatten(sl.icebergMentalModels)}\n\n`;
  if (sl.reinforcingLoop || sl.balancingLoop) {
    out += '### Bucles de retroalimentación\n\n';
    if (sl.reinforcingLoop) out += `- **Bucle de refuerzo (espiral):** ${flatten(sl.reinforcingLoop)}\n`;
    if (sl.balancingLoop) out += `- **Bucle de equilibrio (estabiliza):** ${flatten(sl.balancingLoop)}\n`;
    out += '\n';
  }
  out += `### Punto de apalancamiento\n\n${flatten(sl.leveragePoint)}\n\n`;
  return out;
}

/**
 * Página "Repaso" al final del capítulo: preguntas de recuerdo sin respuesta, explicar,
 * conectar y calibrar (Sección 21). Las flashcards con respuesta van al apéndice del libro,
 * no aquí (plan §3.4).
 */
function repasoMarkdown(rs) {
  let out = '\\newpage\n\n## Repaso\n\n';
  out += '### Recordar\n\nVuelve a la caja de apertura de este capítulo y respóndelas de memoria, sin mirar atrás:\n\n';
  (rs.recallQuestions || []).forEach((q, i) => { out += `${i + 1}. ${flatten(q.text)}\n`; });
  out += '\n### Explicar\n\n';
  (rs.explainPrompts || []).forEach((p, i) => { out += `${i + 1}. ${flatten(p.text)}\n`; });
  out += '\n### Conectar\n\n';
  if ((rs.interleavedQuestions || []).length) {
    rs.interleavedQuestions.forEach((q, i) => { out += `${i + 1}. ${flatten(q.text)}\n`; });
  } else {
    out += `_${flatten(rs.interleavingException) || 'Este capítulo no tiene capítulo anterior con el cual conectar.'}_\n`;
  }
  out += '\n### Espaciar\n\nLas tarjetas de repaso de este capítulo entran hoy en `DAY_1` (curva de Ebbinghaus: día 1 / 3 / 7 / 21). Ver el apéndice de tarjetas al final del libro.\n\n';
  out += '### Calibrar\n\n_Adición propia del método, no citada de las fuentes originales._ Antes de revisar cada respuesta, califica tu confianza — Alta / Media / Baja — y solo entonces compárala con el texto del capítulo.\n\n';
  return out;
}

/**
 * Página de frontmatter (Prefacio / Introducción): texto libre, sin las cajas del Ciclo de
 * Dominio Activo (retrievalSet vive solo en ChapterIR, no en FrontmatterPage).
 */
function frontmatterMarkdown(page) {
  return `# ${page.title}\n\n${page.body.trim()}\n\n`;
}

/**
 * Página de diagrama vectorial al cierre de cada capítulo (plan §5 — "Diagrams as Source":
 * `dot -Tpdf` produce un PDF vectorial que se incrusta con sintaxis Markdown de imagen; pandoc +
 * xelatex ya soportan imágenes PDF como figura vectorial, sin rasterizar). Usa el mismo helper
 * compartido (`render-diagram.js`) que build-web, para no duplicar la llamada a `dot`.
 */
function mindMapChapterMarkdown(chapter) {
  if (!chapter.mindMapDiagramPath) return '';
  const diagramPath = path.join(ROOT, chapter.mindMapDiagramPath);
  const base = path.basename(chapter.mindMapDiagramPath, '.diagram');
  const pdfPath = path.join(MINDMAP_BUILD_DIR, `${base}.pdf`);
  renderDiagram(diagramPath, pdfPath, 'pdf');
  // Ruta ABSOLUTA deliberada: pandoc resuelve las rutas de imagen de markdown relativas al cwd
  // del proceso pandoc (no al directorio del propio .md), y build-pdf invoca pandoc desde la raíz
  // del repo — una ruta relativa a dist/.build/ no resolvía (reproducido durante esta ejecución,
  // ver Registro de ejecución del plan).
  let out = '\\newpage\n\n## Mapa Mental hasta este Capítulo\n\n';
  out += `![Mapa mental acumulado hasta ${chapter.id}](${pdfPath})\n\n`;
  return out;
}

function chapterMarkdown(chapter) {
  const CDA_SECTION_NUMBERS = new Set([0, 20, 21]);
  let out = `# ${chapter.id} — ${chapter.title}\n\n`;
  const rs = chapter.retrievalSet;
  if (rs) out += openingBoxMarkdown(rs);
  for (const s of chapter.sections) {
    if (CDA_SECTION_NUMBERS.has(s.n)) continue;
    out += `## ${s.n}. ${s.title}\n\n${s.content.trim()}\n\n`;
  }
  if (rs) {
    out += systemsLensMarkdown(rs);
    out += repasoMarkdown(rs);
  }
  out += mindMapChapterMarkdown(chapter);
  return out;
}

/**
 * Apéndice final del libro: todas las flashcards de todos los capítulos, agrupadas por
 * capítulo, CON su respuesta (plan §3.4 — "un apéndice final con todas las flashcards
 * agrupadas"; a diferencia de la página de Repaso por capítulo, que no revela respuestas).
 */
function flashcardAppendixMarkdown(ir) {
  let out = '\\newpage\n\n# Apéndice: Tarjetas de Repaso\n\n';
  out += 'Todas las flashcards del libro, agrupadas por capítulo. Cada una nace en `reviewStage = DAY_1` y se repasa con recuperación activa en los días 1, 3, 7 y 21 (curva de Ebbinghaus).\n\n';
  for (const chapter of ir.chapters) {
    const flashcards = (chapter.retrievalSet && chapter.retrievalSet.flashcards) || [];
    if (!flashcards.length) continue;
    out += `## ${chapter.id} — ${chapter.title}\n\n`;
    // Nota: se evita deliberadamente el separador markdown "---" (thematic break) entre
    // tarjetas — el entorno pandoc 1.19.2.4/xelatex instalado no puede compilarlo
    // (\linethickness indefinido en el template LaTeX por defecto; reproducido de forma
    // aislada durante esta ejecución, ver Registro de ejecución del plan).
    for (const f of flashcards) {
      out += `**${flatten(f.front)}**\n\n${flatten(f.back)}\n\n_(fuente: ${f.sourceEntity} — repaso inicial: ${f.reviewStage})_\n\n`;
    }
  }
  return out;
}

/**
 * Apéndice final del libro: el mapa mental completo (snapshot del último capítulo — plan §5 y
 * §7 "v0.1 sí incluye... mapa completo como apéndice"). Se coloca DESPUÉS del apéndice de
 * flashcards (decisión de esta ejecución, ver Registro de ejecución del plan §9): las flashcards
 * son la última pieza "accionable" del libro (repaso espaciado); el mapa completo cierra el libro
 * como la vista de conjunto — el verdadero "panorama completo" solo tiene sentido como la última
 * página, después de haber visto el detalle capítulo a capítulo y las tarjetas de repaso.
 */
function fullBookMindMapAppendixMarkdown(ir) {
  if (!ir.mindMapFullBookDiagramPath) return '';
  const diagramPath = path.join(ROOT, ir.mindMapFullBookDiagramPath);
  const pdfPath = path.join(MINDMAP_BUILD_DIR, 'full-book.pdf');
  renderDiagram(diagramPath, pdfPath, 'pdf');
  let out = '\\newpage\n\n# Apéndice: Mapa Mental Completo del Libro\n\n';
  out += 'El grafo completo de conceptos, contratos y componentes introducidos a lo largo de todo el libro.\n\n';
  out += `![Mapa mental completo del libro](${pdfPath})\n\n`;
  return out;
}

function buildMarkdown(ir) {
  const header = [
    `% ${ir.metadata.title}`,
    '% book-harness (Book Production Harness)',
    `% ${today()} — versión ${ir.metadata.version}`,
    '',
  ].join('\n');
  const frontmatter = (ir.frontmatter || [])
    .map((p, i) => (i === 0 ? frontmatterMarkdown(p) : '\\newpage\n\n' + frontmatterMarkdown(p)))
    .join('\n');
  const chapters = ir.chapters.map(chapterMarkdown).join('\n\n');
  const appendix = flashcardAppendixMarkdown(ir);
  const mindMapAppendix = fullBookMindMapAppendixMarkdown(ir);
  const chaptersBlock = frontmatter ? '\\newpage\n\n' + chapters : chapters;
  return header + '\n' + frontmatter + '\n' + chaptersBlock + '\n\n' + appendix + '\n\n' + mindMapAppendix;
}

function main() {
  if (!fs.existsSync(IR_PATH)) {
    console.error(`build-pdf: no existe ${path.relative(ROOT, IR_PATH)}. Correr build-book-ir primero.`);
    process.exit(1);
  }
  const ir = JSON.parse(fs.readFileSync(IR_PATH, 'utf8'));

  fs.mkdirSync(BUILD_DIR, { recursive: true });
  const md = buildMarkdown(ir);
  fs.writeFileSync(MD_PATH, md, 'utf8');

  const args = [
    MD_PATH,
    '-f', 'markdown+raw_tex',
    '-o', PDF_PATH,
    '--latex-engine=xelatex',
    '-V', 'mainfont=Helvetica',
    '-V', 'geometry:margin=1in',
    '--toc',
    '--toc-depth=2',
    '--top-level-division=chapter',
  ];

  try {
    execFileSync('pandoc', args, { stdio: 'inherit' });
  } catch (e) {
    console.error('build-pdf: pandoc falló:', e.message);
    process.exit(1);
  }

  if (!fs.existsSync(PDF_PATH)) {
    console.error('build-pdf: pandoc terminó pero dist/book.pdf no existe');
    process.exit(1);
  }

  const stat = fs.statSync(PDF_PATH);
  console.log(`build-pdf: OK → ${path.relative(ROOT, PDF_PATH)} (${stat.size} bytes)`);
  process.exit(0);
}

main();
