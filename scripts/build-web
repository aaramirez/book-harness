#!/usr/bin/env node
'use strict';

/**
 * build-web — BookIR → HTML mínimo con navegación anterior/siguiente (Fase 6 del plan).
 *
 * Lee EXCLUSIVAMENTE dist/book-ir.json (debe existir; correr build-book-ir antes). No vuelve a
 * parsear book/chapters/*.md — así Web y PDF quedan garantizados como dos renderizados del mismo
 * modelo validado (BOOK_HARNESS_BUILD_INSTRUCTIONS(1).md §2, §11).
 */

const fs = require('fs');
const path = require('path');
const { renderDiagram } = require('./lib/render-diagram.js');
const { conceptNodeId } = require('./lib/mindmap.js');

const ROOT = path.resolve(__dirname, '..');
const IR_PATH = path.join(ROOT, 'dist', 'book-ir.json');
const OUT_DIR = path.join(ROOT, 'dist', 'web');
const MINDMAP_BUILD_DIR = path.join(ROOT, 'dist', '.build', 'mindmap');

function escapeHtml(s) {
  return String(s)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
}

const BASE_CSS = `
body { font-family: Georgia, 'Times New Roman', serif; max-width: 780px; margin: 0 auto;
       padding: 2rem 1.25rem 4rem; line-height: 1.55; color: #1a1a1a; background: #fffdf8; }
h1, h2 { font-family: -apple-system, Helvetica, Arial, sans-serif; }
h2 { border-bottom: 1px solid #ddd; padding-bottom: .25rem; margin-top: 2.5rem; }
code, pre { font-family: 'SFMono-Regular', Menlo, Consolas, monospace; }
pre { background: #f4f1ea; padding: .85rem 1rem; overflow-x: auto; border-radius: 4px;
      font-size: .88rem; }
nav.chapter-nav { display: flex; justify-content: space-between; margin: 2.5rem 0;
                  font-family: -apple-system, Helvetica, Arial, sans-serif; }
nav.chapter-nav a { text-decoration: none; }
nav.chapter-nav span.disabled { color: #999; }
table { border-collapse: collapse; margin: 1rem 0; }
th, td { border: 1px solid #ccc; padding: .35rem .6rem; text-align: left; }
.toc a { display: block; padding: .25rem 0; }

/* Ciclo de Dominio Activo (CDA) — bloques estáticos, sin lógica de calendario interactivo
   (ver planes/2026-08-23-metodo-aprendizaje-activo-lector.md §3.4 / §5) */
.cda-box { font-family: -apple-system, Helvetica, Arial, sans-serif; border: 2px solid #2a5;
           background: #f2fbf4; border-radius: 6px; padding: 1rem 1.25rem; margin: 1.5rem 0; }
.cda-box h3 { margin-top: 0; font-size: 1rem; text-transform: uppercase; letter-spacing: .04em;
              color: #226; }
.cda-box.systems-lens { border-color: #a56; background: #fbf3f1; }
.cda-box.practice { border-color: #558; background: #f1f3fb; }
.cda-box ol, .cda-box ul { padding-left: 1.25rem; }
.cda-box .cda-sub { font-weight: bold; margin: .9rem 0 .25rem; }
details.cda-details { margin: .5rem 0; }
details.cda-details summary { cursor: pointer; font-weight: bold; }
.cda-tag { font-size: .75rem; text-transform: uppercase; color: #666; }

/* Mapa mental progresivo (planes/2026-08-24-mapa-mental-progresivo.md) — SVG incrustado inline
   (nunca <img src="...svg">, para preservar los <a xlink:href> internos generados por Graphviz) */
.cda-box.mindmap { border-color: #558022; background: #f6faf0; }
.mindmap-svg { overflow-x: auto; }
.mindmap-svg svg { max-width: 100%; height: auto; display: block; margin: 0 auto; }
`;

function renderList(items) {
  return '<ol>' + items.map((t) => `<li>${escapeHtml(t)}</li>`).join('') + '</ol>';
}

function renderMarkdownish(text) {
  // Renderer mínimo: preserva bloques ```...``` como <pre>, tablas markdown como <table>,
  // el resto como párrafos. Suficiente para el capítulo piloto de BH-v0.1 (sin ambición de
  // soportar Markdown arbitrario).
  const lines = text.split('\n');
  let html = '';
  let i = 0;
  while (i < lines.length) {
    const line = lines[i];
    if (line.startsWith('```')) {
      const buf = [];
      i++;
      while (i < lines.length && !lines[i].startsWith('```')) {
        buf.push(lines[i]);
        i++;
      }
      i++; // saltar la línea de cierre ```
      html += `<pre><code>${escapeHtml(buf.join('\n'))}</code></pre>\n`;
      continue;
    }
    if (line.startsWith('|')) {
      const rows = [];
      while (i < lines.length && lines[i].startsWith('|')) {
        rows.push(lines[i]);
        i++;
      }
      const cellsOf = (r) => r.split('|').slice(1, -1).map((c) => c.trim());
      const header = cellsOf(rows[0]);
      const bodyRows = rows.slice(2).map(cellsOf); // rows[1] es el separador "---"
      html += '<table><thead><tr>' +
        header.map((c) => `<th>${escapeHtml(c)}</th>`).join('') +
        '</tr></thead><tbody>' +
        bodyRows.map((r) => '<tr>' + r.map((c) => `<td>${escapeHtml(c)}</td>`).join('') + '</tr>').join('') +
        '</tbody></table>\n';
      continue;
    }
    if (line.trim() === '') { html += '\n'; i++; continue; }
    html += `<p>${escapeHtml(line)}</p>\n`;
    i++;
  }
  return html;
}

function chapterFileName(chapterId) {
  return `${chapterId}.html`;
}

function frontmatterFileName(pageId) {
  return `${pageId}.html`;
}

/**
 * Página de frontmatter (Prefacio / Introducción): texto libre vía renderMarkdownish, sin las
 * cajas del Ciclo de Dominio Activo (esas son solo de capítulos — retrievalSet vive en
 * ChapterIR, no en FrontmatterPage).
 */
function renderFrontmatterPage(ir, page, prevLink, nextLink) {
  const prev = prevLink
    ? `<a href="${prevLink.href}">&larr; ${escapeHtml(prevLink.label)}</a>`
    : '<span class="disabled">&larr;</span>';
  const next = nextLink
    ? `<a href="${nextLink.href}">${escapeHtml(nextLink.label)} &rarr;</a>`
    : '<span class="disabled">&rarr;</span>';
  return `<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<title>${escapeHtml(page.title)} — ${escapeHtml(ir.metadata.title)}</title>
<style>${BASE_CSS}</style>
</head>
<body>
<p><a href="../index.html">&larr; ${escapeHtml(ir.metadata.title)}</a></p>
<h1>${escapeHtml(page.title)}</h1>
<nav class="chapter-nav">${prev}${next}</nav>
${renderMarkdownish(page.body)}
<nav class="chapter-nav">${prev}${next}</nav>
</body>
</html>
`;
}

function flatten(text) {
  return String(text || '').replace(/\s+/g, ' ').trim();
}

/**
 * Caja de apertura (Sección 0 — Preguntas Guía): expectedOutcome + skeleton + guidingQuestions,
 * SIN respuestas. Se renderiza ANTES de la sección 1 (plan §3.4).
 */
function renderOpeningBox(rs) {
  const skeleton = rs.skeleton || {};
  const guidingQuestions = rs.guidingQuestions || [];
  return `<div class="cda-box opening">
  <span class="cda-tag">Antes de leer</span>
  <h3>Resultado esperado</h3>
  <p>${escapeHtml(flatten(rs.expectedOutcome && rs.expectedOutcome.text))}</p>
  <h3>Esqueleto de este capítulo</h3>
  ${renderList((skeleton.sectionTitles || []).map(flatten))}
  <p><em>Contratos que se van a introducir:</em> ${escapeHtml((skeleton.contractsToBeIntroduced || []).join(', ') || '(ninguno)')}<br>
  <em>Componentes que se van a introducir:</em> ${escapeHtml((skeleton.componentsToBeIntroduced || []).join(', ') || '(ninguno)')}</p>
  <h3>Preguntas guía</h3>
  <p>Respóndelas de memoria al terminar el capítulo (Sección 21 — Recordar), sin volver a mirar atrás.</p>
  ${renderList(guidingQuestions.map((q) => flatten(q.text)))}
</div>`;
}

/**
 * Bloque "Lente de Sistemas" (Sección 20): al cierre del cuerpo del capítulo (plan §3.4).
 */
function renderSystemsLensBox(rs) {
  const sl = rs.systemsLens || {};
  const loops = [];
  if (sl.reinforcingLoop) loops.push(`<li><strong>Bucle de refuerzo (espiral):</strong> ${escapeHtml(flatten(sl.reinforcingLoop))}</li>`);
  if (sl.balancingLoop) loops.push(`<li><strong>Bucle de equilibrio (estabiliza):</strong> ${escapeHtml(flatten(sl.balancingLoop))}</li>`);
  return `<div class="cda-box systems-lens">
  <span class="cda-tag">Releyendo con la Lente de Sistemas</span>
  <h3>El Iceberg</h3>
  <ol>
    <li><strong>Hecho visible:</strong> ${escapeHtml(flatten(sl.icebergVisibleFact))}</li>
    <li><strong>Patrones que se repiten:</strong> ${escapeHtml(flatten(sl.icebergPatterns))}</li>
    <li><strong>Estructuras / reglas / incentivos:</strong> ${escapeHtml(flatten(sl.icebergStructures))}</li>
    <li><strong>Modelos mentales:</strong> ${escapeHtml(flatten(sl.icebergMentalModels))}</li>
  </ol>
  ${loops.length ? `<h3>Bucles de retroalimentación</h3><ul>${loops.join('')}</ul>` : ''}
  <h3>Punto de apalancamiento</h3>
  <p>${escapeHtml(flatten(sl.leveragePoint))}</p>
</div>`;
}

/**
 * Bloque plegable "Practica lo que aprendiste" (Sección 21): Recordar / Explicar / Conectar /
 * Espaciar / Calibrar (plan §3.4). SIN lógica de calendario interactivo (v0.2+).
 */
function renderPracticeBox(rs) {
  const recall = rs.recallQuestions || [];
  const explain = rs.explainPrompts || [];
  const interleaved = rs.interleavedQuestions || [];
  const flashcards = rs.flashcards || [];
  const calibration = rs.calibrationPairs || [];

  const recallHtml = renderList(recall.map((q) => flatten(q.text)));
  const explainHtml = renderList(explain.map((p) => flatten(p.text)));
  const connectHtml = interleaved.length
    ? renderList(interleaved.map((q) => flatten(q.text)))
    : `<p><em>${escapeHtml(flatten(rs.interleavingException) || 'Este capítulo no tiene capítulo anterior con el cual conectar.')}</em></p>`;
  const flashcardsHtml = flashcards.length
    ? '<ul>' + flashcards.map((f) => `<li><details class="cda-details"><summary>${escapeHtml(flatten(f.front))}</summary><p>${escapeHtml(flatten(f.back))}</p><p class="cda-tag">fuente: ${escapeHtml(f.sourceEntity)} — repaso: ${escapeHtml(f.reviewStage)}</p></details></li>`).join('') + '</ul>'
    : '<p>(sin tarjetas)</p>';
  const calibrationHtml = calibration.length
    ? renderList(calibration.map((c) => `Antes de ver la respuesta de "${c.recallQuestion}": ¿tu confianza era ${c.confidenceLevels.join(' / ')}?`))
    : '';

  return `<details class="cda-details" open>
<summary>Practica lo que aprendiste</summary>
<div class="cda-box practice">
  <p class="cda-sub">Recordar</p>
  <p>Vuelve a las preguntas guía de la Sección 0 y respóndelas de memoria, sin mirar atrás:</p>
  ${recallHtml}
  <p class="cda-sub">Explicar</p>
  <p>Explica en voz alta, con palabras simples, como si hablaras con alguien sin contexto técnico:</p>
  ${explainHtml}
  <p class="cda-sub">Conectar</p>
  ${connectHtml}
  <p class="cda-sub">Espaciar</p>
  <p>Tarjetas de repaso de este capítulo (curva de Ebbinghaus: día 1 / día 3 / día 7 / día 21):</p>
  ${flashcardsHtml}
  <p class="cda-sub">Calibrar</p>
  <p><em>Adición propia del método, no citada de las fuentes originales.</em> Antes de revisar cada respuesta, califica tu confianza:</p>
  ${calibrationHtml}
</div>
</details>`;
}

/**
 * Anchors de entidad al inicio del cuerpo de la página del capítulo (mismo patrón que los
 * anchors `id="sN"` que ya existen por sección) — uno por cada entidad que el capítulo introduce
 * o modifica, más los conceptos de glosario (kind: concept) que introduce. Son el destino real de
 * los enlaces `URL` que Graphviz incrusta en el SVG del mapa mental (ver scripts/lib/dot-writer.js
 * y Paso 2.5 del encargo de ejecución: no hay páginas de definición dedicadas por entidad en este
 * alcance v0.1 — la "definición canónica" es, por ahora, el propio capítulo que la introduce).
 */
function renderEntityAnchors(ir, chapter) {
  const ids = [];
  const seen = new Set();
  const push = (id) => {
    if (id && !seen.has(id)) {
      seen.add(id);
      ids.push(id);
    }
  };
  (chapter.contractsIntroduced || []).forEach(push);
  (chapter.componentsIntroduced || []).forEach(push);
  (chapter.contractsModified || []).forEach(push);
  (ir.glossary || [])
    .filter((t) => t.introduced_in === chapter.id && t.kind === 'concept')
    .forEach((t) => push(conceptNodeId(t.term)));
  if (!ids.length) return '';
  return ids.map((id) => `<a id="${escapeHtml(id)}"></a>`).join('');
}

/**
 * Renderiza (dot -Tsvg, vía el helper compartido render-diagram.js) el snapshot `.diagram` de un
 * capítulo y devuelve el SVG como texto, listo para incrustar inline en el HTML.
 */
function renderMindMapSvg(diagramRelPath) {
  const diagramPath = path.join(ROOT, diagramRelPath);
  const base = path.basename(diagramRelPath, '.diagram');
  const svgPath = path.join(MINDMAP_BUILD_DIR, `${base}.svg`);
  renderDiagram(diagramPath, svgPath, 'svg');
  return fs.readFileSync(svgPath, 'utf8');
}

/**
 * El `.diagram` fuente usa URLs relativas a `dist/web/` (p.ej. "chapters/CH-00.html#C-001"),
 * consistente con cómo las usa `mapa.html` (que vive en la raíz de dist/web/). Al incrustar el
 * MISMO SVG dentro de una página de capítulo que ya vive en dist/web/chapters/, ese prefijo
 * "chapters/" sobra y rompería el link — se reescribe aquí. Única excepción documentada al
 * criterio de "un solo .diagram, una sola URL" (Paso 2.5 del encargo de ejecución).
 */
function rewriteSvgHrefsForChapterDir(svg) {
  return svg.replace(/(xlink:href|href)="chapters\//g, '$1="');
}

function renderMindMapBlock(svg, label) {
  return `<div class="cda-box mindmap">
  <span class="cda-tag">Mapa mental</span>
  <h3>${escapeHtml(label)}</h3>
  <p>Los nodos son clicables y llevan a la sección del capítulo que introdujo esa entidad. Los
  nodos con borde rojo son nuevos en este capítulo.</p>
  <div class="mindmap-svg">${svg}</div>
</div>`;
}

function renderChapterPage(ir, chapter) {
  const prev = chapter.previousChapter
    ? `<a href="${chapterFileName(chapter.previousChapter)}">&larr; ${escapeHtml(chapter.previousChapter)}</a>`
    : '<span class="disabled">&larr; (sin capítulo anterior)</span>';
  const next = chapter.nextChapter
    ? `<a href="${chapterFileName(chapter.nextChapter)}">${escapeHtml(chapter.nextChapter)} &rarr;</a>`
    : '<span class="disabled">(sin capítulo siguiente todavía) &rarr;</span>';

  // Secciones 0/20/21 (Ciclo de Dominio Activo) se renderizan como bloques estructurados desde
  // retrievalSet, no con el renderer genérico de prosa — evita duplicar el mismo contenido dos
  // veces (una vez como prosa libre, otra como caja) (plan §3.4).
  const CDA_SECTION_NUMBERS = new Set([0, 20, 21]);
  const sectionsHtml = chapter.sections
    .filter((s) => !CDA_SECTION_NUMBERS.has(s.n))
    .map((s) => `<h2 id="s${s.n}">${s.n}. ${escapeHtml(s.title)}</h2>\n${renderMarkdownish(s.content)}`)
    .join('\n');

  const rs = chapter.retrievalSet;
  const openingBox = rs ? renderOpeningBox(rs) : '';
  const systemsLensBox = rs ? renderSystemsLensBox(rs) : '';
  const practiceBox = rs ? renderPracticeBox(rs) : '';

  const entityAnchors = renderEntityAnchors(ir, chapter);
  const mindMapBlock = chapter.mindMapDiagramPath
    ? renderMindMapBlock(
        rewriteSvgHrefsForChapterDir(renderMindMapSvg(chapter.mindMapDiagramPath)),
        `Hasta ${chapter.id} — ${chapter.title}`
      )
    : '';

  return `<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<title>${escapeHtml(chapter.title)} — ${escapeHtml(ir.metadata.title)}</title>
<style>${BASE_CSS}</style>
</head>
<body>
<p><a href="index.html">&larr; ${escapeHtml(ir.metadata.title)}</a></p>
<h1>${escapeHtml(chapter.id)} — ${escapeHtml(chapter.title)}</h1>
${entityAnchors}
<nav class="chapter-nav">${prev}${next}</nav>
${openingBox}
${sectionsHtml}
${systemsLensBox}
${mindMapBlock}
${practiceBox}
<nav class="chapter-nav">${prev}${next}</nav>
</body>
</html>
`;
}

function renderIndexPage(ir) {
  const frontmatterToc = (ir.frontmatter || [])
    .map((p) => `<a href="frontmatter/${frontmatterFileName(p.id)}">${escapeHtml(p.title)}</a>`)
    .join('\n');
  const toc = ir.chapters
    .map((c) => `<a href="chapters/${chapterFileName(c.id)}">${escapeHtml(c.id)} — ${escapeHtml(c.title)}</a>`)
    .join('\n');
  return `<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<title>${escapeHtml(ir.metadata.title)}</title>
<style>${BASE_CSS}</style>
</head>
<body>
<h1>${escapeHtml(ir.metadata.title)}</h1>
<p>Versión ${escapeHtml(ir.metadata.version)} — book-harness (BH-v0.1)</p>
<p><a href="mapa.html">Mapa mental completo del libro</a></p>
<div class="toc">
${frontmatterToc}
${toc}
</div>
</body>
</html>
`;
}

/**
 * Página global `dist/web/mapa.html` (plan §5): el mapa mental completo acumulado hasta el
 * capítulo actual del libro (snapshot de `full-book.diagram`). A diferencia del bloque por
 * capítulo, esta página vive en la raíz de dist/web/, así que los hrefs "chapters/CH-XX.html#..."
 * del .diagram fuente son correctos TAL CUAL (no requieren el rewrite que sí necesita el bloque
 * incrustado dentro de dist/web/chapters/*.html).
 */
function renderMapaPage(ir, svg) {
  return `<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<title>Mapa mental — ${escapeHtml(ir.metadata.title)}</title>
<style>${BASE_CSS}</style>
</head>
<body>
<p><a href="index.html">&larr; ${escapeHtml(ir.metadata.title)}</a></p>
<h1>Mapa mental completo del libro</h1>
<p>Todos los conceptos, contratos y componentes introducidos hasta el capítulo actual del libro.
Los nodos son clicables y llevan a la sección del capítulo que introdujo cada entidad.</p>
<div class="mindmap-svg">${svg}</div>
</body>
</html>
`;
}

/**
 * Sección "Diagramas Interactivos" (Archify) — paso NUEVO, independiente del pipeline
 * zero-dependencias de capítulos/mapa mental de arriba. Archify (https://github.com/tt-a1i/archify)
 * no es una dependencia de este proyecto: los HTML ya vienen entregados (delivered) en
 * diagrams/archify/rendered/*.html por un paso de autoría manual/agente, y este paso SOLO copia
 * esos artefactos íntegros a dist/web/diagramas/ — nunca los regenera ni los modifica. Si el
 * directorio no existe (p.ej. alguien clona el repo sin haber corrido ese paso de autoría), este
 * paso se salta limpiamente sin fallar el build, preservando el pipeline zero-dependencias para
 * cualquiera que solo quiera los 28 capítulos + mapa mental + PDF.
 */
const ARCHIFY_DIR = path.join(ROOT, 'diagrams', 'archify');
const ARCHIFY_RENDERED_DIR = path.join(ARCHIFY_DIR, 'rendered');
const ARCHIFY_OUT_DIR = path.join(OUT_DIR, 'diagramas');

function renderDiagramCards(items) {
  return items
    .map(
      (d) => `<a class="diagram-card" href="diagramas/${escapeHtml(d.file)}">
  <h2>${escapeHtml(d.title)}</h2>
  <p>${escapeHtml(d.description)}</p>
</a>`
    )
    .join('\n');
}

function renderDiagramasIndexPage(general, porCapitulo) {
  const generalCards = renderDiagramCards(general);
  const porCapituloCards = renderDiagramCards(porCapitulo);
  return `<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<title>Diagramas Interactivos — book-harness</title>
<style>${BASE_CSS}
.diagram-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
                gap: 1rem; margin: 1.5rem 0; }
.diagram-card { display: block; border: 1px solid #ccc; border-radius: 6px; padding: 1rem 1.15rem;
                text-decoration: none; color: inherit; background: #f4f1ea; }
.diagram-card:hover { border-color: #558; background: #eef0fb; }
.diagram-card h2 { margin: 0 0 .4rem; font-size: 1.05rem; }
.diagram-card p { margin: 0; font-size: .92rem; color: #444; }
</style>
</head>
<body>
<p><a href="index.html">&larr; book-harness</a></p>
<h1>Diagramas Interactivos</h1>
<p>Estos diagramas son distintos de los mapas mentales por capítulo (<a href="mapa.html">mapa.html</a>):
son diagramas curados, navegables — con búsqueda, trazado de rutas, vistas guiadas y tema
claro/oscuro — generados con <a href="https://github.com/tt-a1i/archify">Archify</a> a partir del
contenido real del libro (nombres de función, componentes y estados citados contra los capítulos
que los publican, sin inventar topología).</p>
<h2>Vistas Generales</h2>
<div class="diagram-grid">
${generalCards}
</div>
<h2>Por Capítulo</h2>
<p>La sección "10. Diagrama de Secuencia" real de cada capítulo, convertida a Archify —
mismo contenido, ahora navegable.</p>
<div class="diagram-grid">
${porCapituloCards}
</div>
</body>
</html>
`;
}

/**
 * Cada `diagrams/archify/<slug>.json` es la fuente que produjo el `.html` entregado del mismo
 * nombre en `rendered/` — leerlo aquí (solo `meta.title`/`meta.subtitle`, JSON.parse plano, sin
 * dependencia nueva) evita mantener una lista de títulos hardcodeada y desincronizable del
 * contenido real. Un `.html` sin `.json` fuente (no debería ocurrir en este flujo) cae de vuelta
 * al nombre de archivo.
 */
function loadArchifyMeta(slug) {
  const jsonPath = path.join(ARCHIFY_DIR, `${slug}.json`);
  if (!fs.existsSync(jsonPath)) return { title: slug, description: '' };
  try {
    const spec = JSON.parse(fs.readFileSync(jsonPath, 'utf8'));
    return {
      title: (spec.meta && spec.meta.title) || slug,
      description: (spec.meta && spec.meta.subtitle) || '',
    };
  } catch (e) {
    return { title: slug, description: '' };
  }
}

function buildArchifyDiagramsSection() {
  if (!fs.existsSync(ARCHIFY_RENDERED_DIR)) {
    console.log('build-web: diagrams/archify/rendered/ no existe — se omite la sección de Diagramas Interactivos.');
    return { built: false, available: [] };
  }
  // Excluye los sidecars de evidencia que `archify visual-check` deja junto al HTML entregado
  // (p.ej. "<nombre>.visual-check.html", además de sus .png/.json) — solo se copian los
  // artefactos realmente entregados por `archify deliver`.
  const entries = fs
    .readdirSync(ARCHIFY_RENDERED_DIR)
    .filter((f) => f.endsWith('.html') && !f.includes('.visual-check.'))
    .sort();
  if (entries.length === 0) {
    console.log('build-web: diagrams/archify/rendered/ existe pero está vacío — se omite la sección de Diagramas Interactivos.');
    return { built: false, available: [] };
  }
  fs.mkdirSync(ARCHIFY_OUT_DIR, { recursive: true });
  const general = [];
  const porCapitulo = [];
  for (const entry of entries) {
    const srcPath = path.join(ARCHIFY_RENDERED_DIR, entry);
    const destPath = path.join(ARCHIFY_OUT_DIR, entry);
    // Copia íntegra, byte a byte — nunca se re-renderiza ni se modifica el HTML ya entregado por
    // Archify (son artefactos firmados/validados por su propio pipeline de deliver+visual-check).
    fs.copyFileSync(srcPath, destPath);
    const slug = entry.replace(/\.html$/, '');
    const meta = loadArchifyMeta(slug);
    // "capitulo-NN-..." (dos dígitos, prefijo fijo) agrupa las conversiones 1:1 de la sección
    // "10. Diagrama de Secuencia" de cada capítulo; todo lo demás son vistas generales curadas.
    const isPerChapter = /^capitulo-\d{2}-/.test(slug);
    const description = meta.description || (isPerChapter ? 'Diagrama de Secuencia real de este capítulo (sección 10), convertido a Archify.' : '');
    const item = { file: entry, title: meta.title, description };
    if (isPerChapter) porCapitulo.push(item);
    else general.push(item);
  }
  // "Por Capítulo" ordenado numéricamente por el NN del prefijo (el sort() de arriba ya es
  // lexicográfico, pero lo hacemos explícito para no depender de que todos los NN tengan
  // exactamente 2 dígitos).
  porCapitulo.sort((a, b) => {
    const na = parseInt(a.file.match(/^capitulo-(\d+)-/)[1], 10);
    const nb = parseInt(b.file.match(/^capitulo-(\d+)-/)[1], 10);
    return na - nb;
  });
  fs.writeFileSync(path.join(OUT_DIR, 'diagramas.html'), renderDiagramasIndexPage(general, porCapitulo), 'utf8');
  const total = general.length + porCapitulo.length;
  console.log(
    `build-web: diagramas.html + ${total} diagrama(s) interactivo(s) copiado(s) → dist/web/diagramas/ ` +
      `(${general.length} vista(s) general(es), ${porCapitulo.length} por capítulo)`
  );
  return { built: true, available: [...general, ...porCapitulo] };
}

function main() {
  if (!fs.existsSync(IR_PATH)) {
    console.error(`build-web: no existe ${path.relative(ROOT, IR_PATH)}. Correr build-book-ir primero.`);
    process.exit(1);
  }
  const ir = JSON.parse(fs.readFileSync(IR_PATH, 'utf8'));

  fs.mkdirSync(path.join(OUT_DIR, 'chapters'), { recursive: true });
  fs.mkdirSync(path.join(OUT_DIR, 'frontmatter'), { recursive: true });
  fs.writeFileSync(path.join(OUT_DIR, 'index.html'), renderIndexPage(ir), 'utf8');

  const frontmatterPages = ir.frontmatter || [];
  const firstChapter = ir.chapters[0];
  frontmatterPages.forEach((page, i) => {
    const prevPage = frontmatterPages[i - 1];
    const nextPage = frontmatterPages[i + 1];
    const prevLink = prevPage
      ? { href: frontmatterFileName(prevPage.id), label: prevPage.title }
      : null; // la primera página de frontmatter solo enlaza "atrás" al índice (arriba de la página)
    const nextLink = nextPage
      ? { href: frontmatterFileName(nextPage.id), label: nextPage.title }
      : firstChapter
        ? { href: `../chapters/${chapterFileName(firstChapter.id)}`, label: `${firstChapter.id} — ${firstChapter.title}` }
        : null;
    fs.writeFileSync(
      path.join(OUT_DIR, 'frontmatter', frontmatterFileName(page.id)),
      renderFrontmatterPage(ir, page, prevLink, nextLink),
      'utf8'
    );
  });

  for (const chapter of ir.chapters) {
    fs.writeFileSync(
      path.join(OUT_DIR, 'chapters', chapterFileName(chapter.id)),
      renderChapterPage(ir, chapter),
      'utf8'
    );
  }

  if (ir.mindMapFullBookDiagramPath) {
    const fullSvg = renderMindMapSvg(ir.mindMapFullBookDiagramPath);
    fs.writeFileSync(path.join(OUT_DIR, 'mapa.html'), renderMapaPage(ir, fullSvg), 'utf8');
  }

  const archifySection = buildArchifyDiagramsSection();
  if (archifySection.built) {
    const indexPath = path.join(OUT_DIR, 'index.html');
    const indexHtml = fs.readFileSync(indexPath, 'utf8').replace(
      '<p><a href="mapa.html">Mapa mental completo del libro</a></p>',
      '<p><a href="mapa.html">Mapa mental completo del libro</a></p>\n<p><a href="diagramas.html">Diagramas Interactivos (Archify)</a></p>'
    );
    fs.writeFileSync(indexPath, indexHtml, 'utf8');
  }

  console.log(`build-web: OK → ${path.relative(ROOT, OUT_DIR)}/`);
  console.log(`  index.html + ${frontmatterPages.length} página(s) de frontmatter + ${ir.chapters.length} capítulo(s) + mapa.html`);
  process.exit(0);
}

main();
